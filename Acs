echo "---------------------------"
get_users | while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    else
        if [ -f "$dir/.rhosts" ] && [ ! -h "$dir/.rhosts" ]; then
            echo ".rhosts file \"$dir/.rhosts\" exists."
        fi
    fi
done

