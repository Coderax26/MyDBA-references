My recommended final combined version is below. This will run all 6 checks together and still keeps the numbering.

#!/bin/bash
# ==========================================================
# User home directory and hidden file security checks
# Red Hat Linux compatible
# ==========================================================
get_users() {
    awk -F: '
    $1 !~ /^(root|halt|sync|shutdown)$/ &&
    $7 !~ /(nologin|false)$/ {
        print $1, $6
    }
    ' /etc/passwd
}
echo "-------------------------------"
echo "1. Check missing home directory"
echo "-------------------------------"
get_users | while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    fi
done
echo
echo "----------------------------------------------------"
echo "2. Check missing home directory and ownership of home"
echo "----------------------------------------------------"
get_users | while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    else
        owner=$(stat -L -c "%U" "$dir")
        if [ "$owner" != "$user" ]; then
            echo "The home directory \"$dir\" of user \"$user\" is owned by \"$owner\"."
        fi
    fi
done
echo
echo "---------------------------------------------------------"
echo "3. Check group and other write permission on home files"
echo "---------------------------------------------------------"
get_users | while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    else
        for file in "$dir"/.[A-Za-z0-9]*
        do
            [ -e "$file" ] || continue
            if [ ! -h "$file" ] && [ -f "$file" ]; then
                fileperm=$(ls -ld "$file" | awk '{print $1}')
                if [ "$(echo "$fileperm" | cut -c6)" != "-" ]; then
                    echo "Group write permission is set on file \"$file\"."
                fi
                if [ "$(echo "$fileperm" | cut -c9)" != "-" ]; then
                    echo "Other write permission is set on file \"$file\"."
                fi
            fi
        done
    fi
done
echo
