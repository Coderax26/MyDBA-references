Below are the same scripts rewritten in proper Linux shell format. I kept the numbering as you requested.

These scripts read /etc/passwd, skip system accounts like root, halt, sync, shutdown, nologin, and /bin/false, then validate user home directories and files.

#!/bin/bash
# -------------------------------
# 1. Check missing home directory
# -------------------------------
grep -Ev '^(root|halt|sync|shutdown)' /etc/passwd | \
awk -F: '($7 != "'"$(which nologin)"'" && $7 != "/bin/false") { print $1, $6 }' | \
while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    fi
done
#!/bin/bash
# ----------------------------------------------------
# 2. Check missing home directory and ownership of home
# ----------------------------------------------------
grep -Ev '^(root|halt|sync|shutdown)' /etc/passwd | \
awk -F: '($7 != "'"$(which nologin)"'" && $7 != "/bin/false") { print $1, $6 }' | \
while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    else
        owner=$(stat -L -c "%U" "$dir")
        if [ "$owner" != "$user" ]; then
            echo "The home directory \"$dir\" of user \"$user\" is owned by \"$owner\"."
        fi
    fi
done
#!/bin/bash
# ---------------------------------------------------------
# 3. Check group and other write permission on home files
# ---------------------------------------------------------
grep -Ev '^(root|halt|sync|shutdown)' /etc/passwd | \
awk -F: '($7 != "'"$(which nologin)"'" && $7 != "/bin/false") { print $1, $6 }' | \
while read -r user dir
do
    if [ ! -d "$dir" ]; then
        echo "The home directory \"$dir\" of user \"$user\" does not exist."
    else
        for file in "$dir"/.[A-Za-z0-9]*
        do
            if [ ! -h "$file" ] && [ -f "$file" ]; then
                fileperm=$(ls -ld "$file" | cut -c1-10)
                if [ "$(echo "$fileperm" | cut -c6)" != "-" ]; then
                    echo "Group write permission is set on file \"$file\"."
                fi
                if [ "$(echo "$fileperm" | cut -c9)" != "-" ]; then
                    echo "Other write permission is set on file \"$file\"."
                fi
            fi
        done
    fi
done
