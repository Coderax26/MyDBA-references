SELECT 
    b.inst_id         AS blocker_inst_id,
    b.sid             AS blocker_sid,
    b.serial#         AS blocker_serial,
    b.username        AS blocker_username,
    b.status          AS blocker_status,
    b.sql_id          AS current_sql_id,
    b.prev_sql_id     AS prev_sql_id,
    NVL(b.sql_id, b.prev_sql_id) AS relevant_sql_id,
    b.event           AS blocker_wait_event,
    b.seconds_in_wait AS seconds_in_wait,
    b.machine,
    b.program
FROM gv$session b
WHERE (b.inst_id, b.sid) IN (
    -- Sessions that are blocking others
    SELECT blocking_instance, blocking_session 
    FROM gv$session 
    WHERE blocking_session IS NOT NULL
)
AND (b.inst_id, b.sid) NOT IN (
    -- Exclude sessions that are themselves blocked by someone else
    SELECT inst_id, sid 
    FROM gv$session 
    WHERE blocking_session IS NOT NULL
);










SELECT type, COUNT(DISTINCT group#) grps, COUNT(*) members
FROM v$logfile GROUP BY type;

SELECT 'ONLINE' t, thread#, COUNT(*) grps, MIN(group#) lo, MAX(group#) hi,
       MIN(bytes)/1048576 min_mb, MAX(bytes)/1048576 max_mb
FROM v$log GROUP BY thread#
UNION ALL
SELECT 'STANDBY', thread#, COUNT(*), MIN(group#), MAX(group#),
       MIN(bytes)/1048576, MAX(bytes)/1048576
FROM v$standby_log GROUP BY thread#;

SELECT type, records_total, records_used
FROM v$controlfile_record_section WHERE type='REDO LOG';
