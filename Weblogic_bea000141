#!/usr/bin/env bash
# wls_cluster_403_diag.sh
# Finds WHO is returning the 403 on the WebLogic cluster-internal endpoint
# (BEA-000141: "TCP/IP socket failure occurred while fetching state dump over HTTP").
#
# STEP A - run on the node that logs BEA-000141 (the node fetching from the peer):
#     ./wls_cluster_403_diag.sh <peer_host_or_ip> <peer_port> [http|https]
#
# STEP B - run on the PEER node (server-side checks: config, logs, access.log):
#     SERVER_ONLY=1 DOMAIN_HOME=/u01/oracle/user_projects/domains/base_domain \
#     SERVER_NAME=ManagedServer_2 FIND_MARKER=<marker printed in step A> \
#     ./wls_cluster_403_diag.sh <peer_host_or_ip> <peer_port>

PEER_HOST="${1:-}"; PEER_PORT="${2:-}"; SCHEME="${3:-http}"
[[ -z "$PEER_HOST" || -z "$PEER_PORT" ]] && { echo "Usage: $0 <peer_host_or_ip> <peer_port> [http|https]"; exit 2; }

CLUSTER_PATH="${CLUSTER_PATH:-/bea_wls_cluster_internal/psquare/p2}"
MARKER="wlsdiag$(date +%s)"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
FINDINGS=(); HAVE_PROXY=""; R_PX=""

note() { FINDINGS+=("$*"); }
hdr()  { printf '\n=== %s ===\n' "$*"; }
summary() {
  hdr "LIKELY CAUSE / WHAT TO DO"
  if ((${#FINDINGS[@]} == 0)); then echo "No conclusive finding - share this output for review."; return; fi
  local i=1 f; for f in "${FINDINGS[@]}"; do echo " $i) $f"; ((i++)); done
}

# probe <label> <url> [extra curl args]  -> sets CODE and FP (who generated the response)
probe() {
  local label="$1" url="$2" out rc h b; shift 2
  : >"$TMP/body"; : >"$TMP/hdr"; FP=""
  out=$(curl -sS -k -o "$TMP/body" -D "$TMP/hdr" --connect-timeout 5 --max-time 15 \
        -w '%{http_code} (connect %{time_connect}s, total %{time_total}s)' "$@" "$url" 2>"$TMP/err")
  rc=$?
  if ((rc != 0)); then
    CODE="curl-rc$rc"; printf '%-34s %s  %s\n' "$label" "$CODE" "$(head -c 150 "$TMP/err")"; return
  fi
  CODE="${out%% *}"; printf '%-34s %s\n' "$label" "$out"
  h=$(tr -d '\r' <"$TMP/hdr"); b=$(head -c 3000 "$TMP/body")
  if   grep -qiE 'Error [0-9]{3}--' <<<"$b";                               then FP="WebLogic"
  elif grep -qiE 'request(ed URL)? was rejected|support ID' <<<"$b";       then FP="F5 ASM / WAF"
  elif grep -qiE '^server:.*(oracle-http|apache|nginx|bigip|f5)|^via:|squid|zscaler|bluecoat|forcepoint' <<<"$h$b"; then
       FP="web server / proxy ($(grep -i '^server:' <<<"$h" | head -1 | tr -d '\n'))"
  else FP="unidentified"; fi
  if [[ "$CODE" == 4* || "$CODE" == 5* ]]; then
    echo "      generated by: $FP"
    grep -iE '^(server|via|x-[a-z-]*cache|x-squid-error|x-powered-by):' <<<"$h" | sed 's/^/      hdr: /'
    echo "      body: $(sed -e 's/<[^>]*>/ /g' <<<"$b" | tr -s ' \n' ' ' | head -c 160)"
  fi
}

###############################################################################
if [[ -z "${SERVER_ONLY:-}" ]]; then

hdr "1. This node: name resolution, source IP, proxy settings"
echo "This node : $(hostname -f 2>/dev/null || hostname)"
PEER_IP=$(getent ahostsv4 "$PEER_HOST" 2>/dev/null | awk 'NR==1{print $1}'); PEER_IP="${PEER_IP:-$PEER_HOST}"
echo "Peer      : $PEER_HOST -> $(getent ahosts "$PEER_HOST" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')"
grep -nF "$PEER_HOST" /etc/hosts 2>/dev/null | sed 's#^#  /etc/hosts: #'
echo "Source IP the peer will see: $(ip route get "$PEER_IP" 2>/dev/null | grep -oE 'src [0-9.]+' | head -1 | cut -d' ' -f2)"

PV=$(env | grep -iE '^(http|https|all|no)_proxy=' | sed -E 's#://[^@/]*@#://***@#')
if [[ -n "$PV" ]]; then HAVE_PROXY=1; echo "Shell proxy variables:"; sed 's/^/   /' <<<"$PV"
else echo "Shell proxy variables: none"; fi

JVM=$(ps -eo args 2>/dev/null | grep -E '^[^ ]*java[^ ]* .*-Dweblogic\.Name=' | tr ' ' '\n' | grep -iE '^-Dweblogic\.Name=|proxyHost|proxyPort|nonProxyHosts')
if [[ -n "$JVM" ]]; then echo "Flags on running WebLogic JVMs:"; sed 's/^/   /' <<<"$JVM"
else echo "No running WebLogic JVM found on this node."; fi
grep -qi 'proxyHost' <<<"$JVM" && note "A WebLogic JVM on this node has -Dhttp(s).proxyHost set. The state-dump fetch goes through that proxy unless the peer is listed in -Dhttp.nonProxyHosts - a proxy answering 403 produces exactly this symptom."

hdr "2. TCP connect to $PEER_HOST:$PEER_PORT"
if timeout 5 bash -c "exec 3<>/dev/tcp/$PEER_IP/$PEER_PORT" 2>/dev/null; then
  echo "[PASS] port is open"
else
  echo "[FAIL] cannot open a TCP connection"
  note "TCP connect fails - this is a network/firewall/listener problem, not a 403 problem. Check the peer is RUNNING, its listen address, and firewalls."
  summary; exit 1
fi

hdr "3. HTTP probes (shell proxy bypassed)"
BASE="$SCHEME://$PEER_HOST:$PEER_PORT"; SEP='?'; [[ "$CLUSTER_PATH" == *\?* ]] && SEP='&'
CURL_URL="$BASE$CLUSTER_PATH$SEP$MARKER=1"
probe "A. /weblogic/ready"       "$BASE/weblogic/ready" --noproxy '*'; R_READY=$CODE
probe "B. / (root)"              "$BASE/"               --noproxy '*'; R_ROOT=$CODE
probe "C. cluster-internal path" "$CURL_URL"            --noproxy '*'; R_CLUS=$CODE; FP_CLUS=$FP
ALT=https; [[ "$SCHEME" == https ]] && ALT=http
probe "D. same path over $ALT"   "$ALT://$PEER_HOST:$PEER_PORT$CLUSTER_PATH" --noproxy '*'; R_ALT=$CODE
if [[ -n "$HAVE_PROXY" ]]; then
  probe "E. cluster path, proxy vars ON" "$CURL_URL"; R_PX=$CODE
fi
echo "Repeat C x10 : $(for i in $(seq 10); do curl -sk --noproxy '*' -o /dev/null -w '%{http_code} ' --connect-timeout 5 --max-time 15 "$CURL_URL"; done)"
echo "Marker       : $MARKER   (use as FIND_MARKER when running STEP B on the peer)"

if [[ "$R_CLUS" == 403 ]]; then
  if [[ "$FP_CLUS" == WebLogic ]]; then
    note "The 403 is produced by WebLogic itself on the peer. Run STEP B there: look for connection-filter rules, channel / Administration Port settings, and the access.log entry."
  else
    note "The 403 is NOT produced by WebLogic; it comes from something in front of it: $FP_CLUS. Confirm with STEP B (marker absent from the peer's access.log), then ask the network/LB/WAF team to allow /bea_wls_cluster_internal/* between cluster nodes."
  fi
  if [[ "$R_READY" != 403 && "$R_ROOT" != 403 ]]; then
    note "Only /bea_wls_cluster_internal is blocked (A and B are not 403): a path-specific rule in a proxy / LB / WAF / web-server plugin."
  else
    note "A and/or B return 403 too: the whole listener is denying this source IP (connection filter, ACL, proxy or firewall)."
  fi
else
  case "$R_CLUS" in
    2*|400|405|500) note "With the proxy bypassed the endpoint answers HTTP $R_CLUS: the HTTP layer is reachable from this shell and the 403 is not reproduced here." ;;
    404) note "HTTP 404: /bea_wls_cluster_internal is not being served on the peer (not deployed/targeted yet, or the peer is not fully RUNNING)." ;;
    503) note "HTTP 503: peer is up but not ready (starting, standby or overloaded). Check its state and /weblogic/ready." ;;
    curl-rc*) note "HTTP request to $SCHEME fails at protocol level ($R_CLUS)." ;;
    *)   note "Unexpected result '$R_CLUS' - see probe output above." ;;
  esac
  if [[ "$R_CLUS" == curl-rc* && "$R_ALT" =~ ^[0-9]{3}$ ]]; then
    note "The port answers over $ALT but not $SCHEME: that channel is $ALT-only (SSL-only channel or Administration Port enabled)."
  fi
  [[ "$R_PX" == 403 ]] && note "403 appears ONLY when the shell's proxy variables are honoured, so the proxy is returning it. Add the peer to no_proxy; for the JVM use -Dhttp.nonProxyHosts."
fi

fi  # end of client-side steps
###############################################################################

if [[ -n "${DOMAIN_HOME:-}" && -d "$DOMAIN_HOME" ]]; then
  hdr "4. Server-side checks on $(hostname) (DOMAIN_HOME=$DOMAIN_HOME)"
  echo "Sockets listening on port $PEER_PORT:"
  (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep -E "[:.]$PEER_PORT[[:space:]]" | sed 's/^/   /'

  CFG="$DOMAIN_HOME/config/config.xml"
  if [[ -r "$CFG" ]]; then
    echo "config.xml - connection filter, channels, admin port, messaging mode, proxy flags:"
    grep -nEi 'connection-filter|ConnectionFilter|administration-port|enable-tunneling|cluster-messaging-mode|cluster-address|http-enabled-for-this-protocol|network-access-point|weblogic-plugin-enabled|frontend-host|proxyHost|nonProxyHosts' "$CFG" | sed 's/^/   /' | head -60
  fi

  for d in "$DOMAIN_HOME"/servers/${SERVER_NAME:-*}/logs; do
    [[ -d "$d" ]] || continue
    S=$(basename "$(dirname "$d")"); [[ "$S" == domain_bak ]] && continue
    echo; echo "--- server: $S ---"
    ACC="$d/access.log"; LOG="$d/$S.log"
    if [[ -r "$ACC" ]]; then
      echo "access.log - /bea_wls_cluster_internal requests by HTTP status:"
      grep -F 'bea_wls_cluster_internal' "$ACC" | awk '{c[$9]++} END{for(k in c) print "   " k ": " c[k]}'
      echo "Source IPs that received 403:"
      grep -F 'bea_wls_cluster_internal' "$ACC" | awk '$9==403{print $1}' | sort | uniq -c | sort -rn | head -5 | sed 's/^/   /'
      if [[ -n "${FIND_MARKER:-}" ]]; then
        if grep -F "$FIND_MARKER" "$ACC" | tail -3 | sed 's/^/   marker hit: /' | grep .; then
          note "Marker $FIND_MARKER IS in $S access.log: the request reached WebLogic (status shown above), so the cause is inside WLS config (connection filter, channel, security)."
        else
          note "Marker $FIND_MARKER is NOT in $S access.log: the 403 never reached WebLogic. It is produced upstream (proxy / LB / WAF / firewall), unless your access.log format omits query strings."
        fi
      fi
      echo "Last 5 cluster-internal requests:"
      grep -F 'bea_wls_cluster_internal' "$ACC" | tail -5 | sed 's/^/   /'
    else
      echo "access.log not readable at $ACC (HTTP access logging may be disabled)."
    fi
    if [[ -r "$LOG" ]]; then
      echo "Server log - related entries (last 15):"
      grep -nEi 'BEA-000141|connection filter|rejected|forbidden|BEA-090' "$LOG" | tail -15 | sed 's/^/   /'
    fi
  done
fi

summary
