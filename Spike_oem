from awr ----
SELECT 
    e.instance_number,
    e.event_name,
    e.total_waits,
    e.time_waited_micro/1000000 AS time_waited_secs,
    (e.time_waited_micro/1000000)/e.total_waits*1000 AS avg_wait_ms,
    e.wait_class
FROM 
    dba_hist_system_event e
    JOIN dba_hist_snapshot s 
        ON e.snap_id = s.snap_id 
        AND e.instance_number = s.instance_number
WHERE 
    s.begin_interval_time >= TO_TIMESTAMP('2026-05-19 10:00:00','YYYY-MM-DD HH24:MI:SS')
    AND s.end_interval_time   <= TO_TIMESTAMP('2026-05-19 11:00:00','YYYY-MM-DD HH24:MI:SS')
    AND e.wait_class NOT IN ('Idle','Background')
ORDER BY 
    time_waited_secs DESC
FETCH FIRST 20 ROWS ONLY;

-- fro my ash ---
SELECT 
    ash.instance_number,
    ash.event,
    ash.wait_class,
    COUNT(*) AS ash_samples,
    ROUND(COUNT(*)/SUM(COUNT(*)) OVER()*100,2) AS pct_total,
    MIN(ash.sample_time) AS first_seen,
    MAX(ash.sample_time) AS last_seen
FROM 
    dba_hist_active_sess_history ash
WHERE 
    ash.sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND ash.session_state = 'WAITING'
    AND ash.wait_class NOT IN ('Idle')
GROUP BY 
    ash.instance_number,
    ash.event,
    ash.wait_class
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS 

-- if its very recent then ---

SELECT 
    inst_id,
    event,
    wait_class,
    COUNT(*) AS ash_samples,
    MIN(sample_time) AS first_seen,
    MAX(sample_time) AS last_seen
FROM 
    gv$active_session_history
WHERE 
    sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND session_state = 'WAITING'
    AND wait_class NOT IN ('Idle')
GROUP BY 
    inst_id, event, wait_class
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS ONLY;






--- query to identify sql causing event

SELECT 
    ash.inst_id,
    ash.sql_id,
    ash.event,
    COUNT(*) AS ash_samples,
    ash.sql_opname,
    ash.program,
    ash.module
FROM 
    gv$active_session_history ash
WHERE 
    ash.sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND ash.session_state = 'WAITING'
    AND ash.event IN (
        'log file sync',
        'gc buffer busy acquire',
        'enq: TX - index contention',
        'gc cr grant 2-way'
    )
GROUP BY 
    ash.inst_id, ash.sql_id, ash.event, 
    ash.sql_opname, ash.program, ash.module
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS ONLY;

----- check sql text

SELECT 
    sql_id,
    sql_text,
    executions,
    rows_processed,
    elapsed_time/1000000 AS elapsed_secs
FROM 
    gv$sql
WHERE 
    sql_id IN (
        'cxxuafmshc4uj',
        '8z2vgmg3dxgnu',
        '519msq7rvjcbw',
        '6nf9k4x4wtwns'
    )
ORDER BY elapsed_time DESC;



---- check LGWR health

SELECT 
    inst_id,
    name,
    value
FROM gv$sysstat
WHERE name IN (
    'redo writes',
    'redo write time',
    'redo size',
    'user commits',
    'user rollbacks'
)
ORDER BY inst_id, name;




---- check hot index

SELECT 
    ash.inst_id,
    ash.current_obj#,
    o.object_name,
    o.object_type,
    o.owner,
    COUNT(*) AS ash_samples
FROM 
    gv$active_session_history ash
    JOIN dba_objects o 
        ON ash.current_obj# = o.object_id
WHERE 
    ash.sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND ash.event = 'enq: TX - index contention'
GROUP BY 
    ash.inst_id, ash.current_obj#, 
    o.object_name, o.object_type, o.owner
ORDER BY ash_samples DESC
FETCH FIRST 10 ROWS ONLY;




----check index structure

SELECT 
    i.index_name,
    i.index_type,
    i.partitioning_type,
    i.status,
    i.leaf_blocks,
    i.blevel,
    i.clustering_factor,
    ip.partition_name,
    ip.status AS part_status,
    ip.leaf_blocks AS part_leaf_blocks
FROM 
    dba_indexes i
    JOIN dba_ind_partitions ip 
        ON i.index_name = ip.index_name
        AND i.owner = ip.index_owner
WHERE 
    i.owner = 'SBINRT82'
    AND i.index_name IN (
        'IDX_DETAIL_SM_SEC_ACCT_NUM',
        'IDX_DETAIL_SM_DEVICE_ID',
        'IDX_SHORTWINDOW_CLUSTER',
        'IDX_SHORTWINDOW_SD_REMOTE_IP'
    )
ORDER BY 
    i.index_name, ip.partition_position DESC
FETCH FIRST 20 ROWS ONLY;



