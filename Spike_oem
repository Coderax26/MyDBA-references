from awr ----
SELECT 
    e.instance_number,
    e.event_name,
    e.total_waits,
    e.time_waited_micro/1000000 AS time_waited_secs,
    (e.time_waited_micro/1000000)/e.total_waits*1000 AS avg_wait_ms,
    e.wait_class
FROM 
    dba_hist_system_event e
    JOIN dba_hist_snapshot s 
        ON e.snap_id = s.snap_id 
        AND e.instance_number = s.instance_number
WHERE 
    s.begin_interval_time >= TO_TIMESTAMP('2026-05-19 10:00:00','YYYY-MM-DD HH24:MI:SS')
    AND s.end_interval_time   <= TO_TIMESTAMP('2026-05-19 11:00:00','YYYY-MM-DD HH24:MI:SS')
    AND e.wait_class NOT IN ('Idle','Background')
ORDER BY 
    time_waited_secs DESC
FETCH FIRST 20 ROWS ONLY;

-- fro my ash ---
SELECT 
    ash.instance_number,
    ash.event,
    ash.wait_class,
    COUNT(*) AS ash_samples,
    ROUND(COUNT(*)/SUM(COUNT(*)) OVER()*100,2) AS pct_total,
    MIN(ash.sample_time) AS first_seen,
    MAX(ash.sample_time) AS last_seen
FROM 
    dba_hist_active_sess_history ash
WHERE 
    ash.sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND ash.session_state = 'WAITING'
    AND ash.wait_class NOT IN ('Idle')
GROUP BY 
    ash.instance_number,
    ash.event,
    ash.wait_class
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS 

-- if its very recent then ---

SELECT 
    inst_id,
    event,
    wait_class,
    COUNT(*) AS ash_samples,
    MIN(sample_time) AS first_seen,
    MAX(sample_time) AS last_seen
FROM 
    gv$active_session_history
WHERE 
    sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND session_state = 'WAITING'
    AND wait_class NOT IN ('Idle')
GROUP BY 
    inst_id, event, wait_class
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS ONLY;






--- query to identify sql causing event

SELECT 
    ash.inst_id,
    ash.sql_id,
    ash.event,
    COUNT(*) AS ash_samples,
    ash.sql_opname,
    ash.program,
    ash.module
FROM 
    gv$active_session_history ash
WHERE 
    ash.sample_time >= SYSDATE - INTERVAL '60' MINUTE
    AND ash.session_state = 'WAITING'
    AND ash.event IN (
        'log file sync',
        'gc buffer busy acquire',
        'enq: TX - index contention',
        'gc cr grant 2-way'
    )
GROUP BY 
    ash.inst_id, ash.sql_id, ash.event, 
    ash.sql_opname, ash.program, ash.module
ORDER BY 
    ash_samples DESC
FETCH FIRST 20 ROWS ONLY;

