▶ STEP 1 — Clear Orphan Datapump Jobs
──────────────────────────────────────
First in CDB$ROOT, then in PDBRPT

-- Check orphan jobs
SQL> SELECT OWNER_NAME, JOB_NAME, STATE,
            OPERATION, JOB_MODE,
            ATTACHED_SESSIONS
     FROM DBA_DATAPUMP_JOBS
     WHERE STATE = 'NOT RUNNING'
     ORDER BY OWNER_NAME, JOB_NAME;

-- For each orphan job found, drop it:
SQL> DECLARE
       h1 NUMBER;
     BEGIN
       h1 := DBMS_DATAPUMP.ATTACH(
               job_name  => '&JOB_NAME',
               job_owner => '&OWNER_NAME');
       DBMS_DATAPUMP.STOP_JOB(h1, 1, 0);
     END;
     /

-- Drop leftover master tables if any:
SQL> DROP TABLE <OWNER>.<JOB_NAME> PURGE;

-- Verify no orphan jobs remain:
SQL> SELECT OWNER_NAME, JOB_NAME, STATE
     FROM DBA_DATAPUMP_JOBS
     WHERE STATE = 'NOT RUNNING';
     -- Expected: NO ROWS

▶ STEP 2 — Bounce PDBRPT (PDB Restart)
──────────────────────────────────────
SQL> ALTER SESSION SET CONTAINER = CDB$ROOT;
SQL> ALTER PLUGGABLE DATABASE PDBRPT CLOSE IMMEDIATE;
SQL> ALTER PLUGGABLE DATABASE PDBRPT OPEN;

-- Verify PDB is open:
SQL> SELECT CON_ID, NAME, OPEN_MODE
     FROM V$PDBS
     WHERE NAME = 'PDBRPT';
     -- Expected: READ WRITE

▶ STEP 3 — Run DST Upgrade (CDB First)
──────────────────────────────────────
-- Connect to CDB$ROOT on Node 1
$ cd $ORACLE_HOME/rdbms/admin
$ sqlplus / as sysdba

SQL> SHOW CON_NAME;
     -- Expected: CDB$ROOT

-- Run check script first:
SQL> spool /tmp/utltz_upg_check_cdb.log
SQL> @utltz_upg_check.sql
SQL> spool off

-- Review log for errors, then apply:
SQL> spool /tmp/utltz_upg_apply_cdb.log
SQL> @utltz_upg_apply.sql
SQL> spool off

⚠️ NOTE: Script will shutdown and restart
         DB 2 times automatically.
         All 6 RAC instances will restart.
         DO NOT interrupt the script.

-- Verify CDB after upgrade:
SQL> SELECT CON_ID, PROPERTY_NAME,
