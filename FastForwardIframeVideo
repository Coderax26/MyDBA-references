function unlockSeekbar(win = window, depth = 0) {
  if (depth > 10) return;

  try {
    // 1. Force all seekbar elements to be clickable and remove the "disabled" look
    const seekbarElements = win.document.querySelectorAll('[class*="seekbar"], [class*=" Seekbar"], [class*="track"], [class*="scrubber"], [class*="Thumb"]');
    seekbarElements.forEach(el => {
      el.style.pointerEvents = 'auto';
      el.style.opacity = '1';
      el.style.filter = 'none';
      el.removeAttribute('disabled');
      el.classList.remove('disabled', 'cs-button-disabled', 'state-disabled');
    });

    // 2. Sometimes Storyline uses a transparent overlay to block clicks. Let's remove those.
    const overlays = win.document.querySelectorAll('[class*="overlay"], [class*="blocker"]');
    overlays.forEach(el => {
      if (getComputedStyle(el).position === 'absolute' && getComputedStyle(el).cursor === 'default') {
         el.style.pointerEvents = 'none';
      }
    });

  } catch (e) {}

  try {
    const len = win.frames.length;
    for (let i = 0; i < len; i++) {
      try {
        unlockSeekbar(win.frames[i], depth + 1);
      } catch (e) {}
    }
  } catch (e) {}
}

unlockSeekbar();
console.log('Seekbar unlock attempt complete. Try clicking and dragging the timeline now.');
